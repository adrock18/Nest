# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Hooks are shell scripts and must stay LF
.githooks/* text eol=lf

# Explicit LF for codebase file formats
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.sql text eol=lf
*.sh text eol=lf

# PowerShell scripts must stay CRLF for native Windows PowerShell
*.ps1 text eol=crlf

# Binary formats
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
