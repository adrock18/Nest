#!/bin/sh
# Blocks pushing code without a passing understanding record.
#
# For each branch being pushed: if new commits change anything other than
# *.md files or understanding/, then understanding/<branch>.md must exist in
# the pushed commit, contain "Verdict: PASS", and reference a valid ancestor commit.
#
# Setup (once per clone):  git config core.hooksPath .githooks
# Run the check:           ask your AI tool for the understanding check
#                          (skills/understanding-check/SKILL.md)

zero=0000000000000000000000000000000000000000
empty_tree=$(git hash-object -t tree /dev/null)
failed=0

# Prints changed files between two commits, excluding markdown docs and understanding records.
code_changes() {
  if ! git rev-parse "$1" >/dev/null 2>&1 || ! git rev-parse "$2" >/dev/null 2>&1; then
    echo "ERROR: invalid commit reference for diff"
    return 1
  fi
  git diff --name-only "$1" "$2" -- | grep -v -E '\.md$' | grep -v -E '^understanding/'
}

block() {
  echo "" >&2
  echo "pre-push: $1" >&2
  if [ "$2" != "nohint" ]; then
    echo "  Ask your AI tool to run the understanding check" >&2
    echo "  (skills/understanding-check/SKILL.md), commit the record, then push again." >&2
  fi
  failed=1
}

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_ref" ] && continue

  # Deleting a remote branch: nothing to check.
  [ "$local_sha" = "$zero" ] && continue

  # Tags are releases of code that was already checked on its branch.
  case "$remote_ref" in refs/tags/*) continue ;; esac

  # Block direct push to main regardless of local branch alias.
  if [ "$remote_ref" = "refs/heads/main" ]; then
    block "code is being pushed directly to main. Use a feature/ or fix/ branch and a pull request." nohint
    continue
  fi

  # Branch name, as used for the record file.
  case "$local_ref" in
    refs/heads/*) branch=${local_ref#refs/heads/} ;;
    *) branch=${remote_ref#refs/heads/} ;;
  esac

  # Determine comparison base commit.
  if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    base=$remote_sha
  else
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null) || base=$empty_tree
  fi

  changed=$(code_changes "$base" "$local_sha")
  if [ $? -ne 0 ]; then
    block "failed to compute code changes between $base and $local_sha." nohint
    continue
  fi
  [ -z "$changed" ] && continue

  record="understanding/$(echo "$branch" | tr '/' '-').md"
  content=$(git show "$local_sha:$record" 2>/dev/null)
  if [ -z "$content" ]; then
    block "'$branch' changes code but has no understanding record ($record)."
    continue
  fi

  if ! echo "$content" | grep -q -E '^Verdict: PASS[[:space:]]*$'; then
    block "$record doesn't say 'Verdict: PASS'."
    continue
  fi

  checked=$(echo "$content" | sed -n 's/^Checked commit: *\([0-9a-f]\{40\}\).*/\1/p' | head -n 1)
  if [ -z "$checked" ] || ! git merge-base --is-ancestor "$checked" "$local_sha" 2>/dev/null; then
    block "$record was made for a commit that isn't part of this branch."
    continue
  fi

  since=$(code_changes "$checked" "$local_sha")
  if [ -n "$since" ]; then
    block "code changed after the understanding check:
$(echo "$since" | sed 's/^/    /')"
    continue
  fi
done

exit $failed
